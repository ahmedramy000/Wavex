{
  "name": "wavex-desktop",
  "version": "2.0.0",
  "description": "Wavex — Connect Differently · تواصل بشكل مختلف",
  "author": "Wavex Team",
  "license": "MIT",
  "main": "electron/main.js",
  "homepage": ".",
  "scripts": {
    "start":         "electron .",
    "dev":           "electron . --dev",
    "build:win":     "electron-builder --win --x64",
    "build:mac":     "electron-builder --mac --universal",
    "build:linux":   "electron-builder --linux --x64",
    "build:all":     "electron-builder --win --mac --linux",
    "build:win-portable": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron":         "^29.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId":       "com.wavex.app",
    "productName": "Wavex",
    "copyright":   "© 2025 Wavex Team",

    "directories": {
      "output": "dist-desktop"
    },

    "files": [
      "index.html",
      "admin.html",
      "manifest.json",
      "sw.js",
      "styles/**",
      "js/**",
      "assets/**",
      "electron/**",
      "build-assets/**"
    ],

    "extraResources": [
      { "from": "build-assets/icons", "to": "icons" }
    ],

    "win": {
      "target": [
        { "target": "nsis",     "arch": ["x64", "ia32"] },
        { "target": "portable", "arch": ["x64"] }
      ],
      "icon":           "build-assets/icons/icon.ico",
      "publisherName":  "Wavex",
      "artifactName":   "Wavex-Setup-${version}-${arch}.${ext}"
    },

    "nsis": {
      "oneClick":          false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName":      "Wavex",
      "installerIcon":     "build-assets/icons/icon.ico",
      "uninstallerIcon":   "build-assets/icons/icon.ico",
      "installerHeaderIcon": "build-assets/icons/icon.ico",
      "license":           "LICENSE.txt"
    },

    "mac": {
      "target": [
        { "target": "dmg",   "arch": ["universal"] },
        { "target": "zip",   "arch": ["universal"] }
      ],
      "icon":           "build-assets/icons/icon-512.png",
      "category":       "public.app-category.social-networking",
      "darkModeSupport": true,
      "artifactName":   "Wavex-${version}-${arch}.${ext}",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements":    "build-assets/entitlements.plist",
      "entitlementsInherit": "build-assets/entitlements.plist"
    },

    "dmg": {
      "title":    "Install Wavex",
      "icon":     "build-assets/icons/icon-512.png",
      "background": "build-assets/dmg-bg.png",
      "window":   { "width": 540, "height": 380 },
      "contents": [
        { "x": 150, "y": 185, "type": "file"   },
        { "x": 390, "y": 185, "type": "link", "path": "/Applications" }
      ]
    },

    "linux": {
      "target": [
        { "target": "AppImage", "arch": ["x64"] },
        { "target": "deb",      "arch": ["x64"] },
        { "target": "rpm",      "arch": ["x64"] },
        { "target": "snap",     "arch": ["x64"] }
      ],
      "icon":        "build-assets/icons",
      "category":    "Network;Chat;",
      "description": "Wavex social platform",
      "artifactName": "Wavex-${version}-${arch}.${ext}",
      "desktop": {
        "Name":       "Wavex",
        "Comment":    "Connect Differently",
        "Categories": "Network;Chat;"
      }
    },

    "appImage": {
      "artifactName": "Wavex-${version}.AppImage"
    },

    "deb": {
      "depends": ["libnotify4", "libxtst6", "libnss3"]
    },

    "snap": {
      "summary": "Wavex — Connect Differently"
    },

    "publish": null
  }
}
